<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Fast test harness for Relic's pure C# code, runnable without Unity:
      dotnet test tools/Relic.Tests
    It compiles every Logic/ folder (no UnityEngine allowed there) and every
    Tests/ folder straight from Assets/. No files need registering: add a .cs file
    under Assets/Relic/<Area>/Logic or /Tests and it is picked up.
    LangVersion 9 matches Unity 6's compiler, so features Unity can't build fail here too.
  -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <DefineConstants>$(DefineConstants);RELIC_DOTNET_HARNESS</DefineConstants>
    <NoWarn>$(NoWarn);CS0649;CS0414</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../../Assets/Relic/**/Logic/**/*.cs" />
    <Compile Include="../../Assets/Relic/**/Tests/**/*.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
  </ItemGroup>

</Project>
